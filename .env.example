# Copy to .env. Never commit secrets. SITE_URL is your public website, not the CMS.
SITE_URL=https://photos.example.com
PORTFOLIO_SOURCE=local
# Enable the CMS after initialization:
# PORTFOLIO_SOURCE=directus
# DIRECTUS_URL=http://127.0.0.1:8055
# DIRECTUS_TOKEN=read-only-build-token
# Administrator token is used only by cms:init / cms:token. Keep out of build jobs.
# DIRECTUS_ADMIN_TOKEN=
