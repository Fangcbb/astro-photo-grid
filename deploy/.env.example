# Copy to deploy/.env and set secure, distinct values. Do not commit this file.
DB_PASSWORD=
DIRECTUS_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
CMS_PUBLIC_URL=https://cms.example.com
CMS_PORT=8055
SITE_PORT=8080
# Tencent COS: bucket name includes APPID; endpoint must match the bucket region.
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=portfolio-1250000000
COS_REGION=ap-shanghai
COS_ENDPOINT=https://cos.ap-shanghai.myqcloud.com
