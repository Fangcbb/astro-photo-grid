{
  "name": "astro-photo-grid",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24.14.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.12.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "dev": "pnpm portfolio:prepare && astro dev",
    "start": "pnpm dev",
    "build": "pnpm portfolio:prepare && astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "pnpm portfolio:prepare && astro check && biome check",
    "check:fix": "pnpm portfolio:prepare && astro check && biome check --write",
    "portfolio:prepare": "node --env-file-if-exists=.env --env-file-if-exists=.env.build scripts/prepare-portfolio.mjs",
    "test": "node --test tests/*.test.mjs",
    "cms:init": "node --env-file-if-exists=.env scripts/init-directus.mjs",
    "cms:token": "node --env-file-if-exists=.env scripts/create-build-token.mjs",
    "site:publish": "node scripts/publish-site.mjs",
    "test:e2e": "playwright test"
  },
  "simple-git-hooks": {
    "pre-commit": "./node_modules/.bin/nano-staged"
  },
  "nano-staged": {
    "*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,json,jsonc,css,astro}": [
      "biome check --write"
    ]
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@fancyapps/ui": "^6.1.15",
    "astro": "^7.3.8",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.1",
    "nano-staged": "^1.0.2",
    "sharp": "^0.35.5",
    "simple-git-hooks": "^2.14.0",
    "wrangler": "^4.149.0"
  }
}
