---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { site } from "~/lib/portfolio";
---
<BaseLayout title="关于">
  <article class="shell about intro">
    <p class="eyebrow">BEHIND THE LENS</p>
    <h1>{site.author}</h1>
    <p>{site.description}</p>
    <p>{site.intro}</p>
    <div class="contact-links">
      {site.email && <a href={`mailto:${site.email}`}>联系我 ↗</a>}
      {site.instagram && <a href={site.instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a>}
    </div>
    <p class="muted">{site.copyright}</p>
  </article>
</BaseLayout>
