---
import Gallery from "~/components/Gallery.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { albums, photos, site } from "~/lib/portfolio";
---
<BaseLayout title={site.name} image={photos[0]?.large}>
  <section class="intro shell">
    <p class="eyebrow">PHOTOGRAPHY PORTFOLIO</p>
    <h1>{site.intro}</h1>
    <p>{site.description}</p>
  </section>
  <section class="shell works" aria-label="摄影作品">
    <div class="collection-bar">
      <nav class="album-nav" aria-label="相册分类">
        <a href="/" aria-current="page">全部作品 <span>{photos.length}</span></a>
        {albums.map((album) => <a href={`/albums/${album.slug}/`}>{album.title} <span>{album.photos.length}</span></a>)}
      </nav>
      <span class="muted">{albums.length} 个系列</span>
    </div>
    <Gallery photos={photos} />
  </section>
</BaseLayout>
